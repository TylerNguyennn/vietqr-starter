PORT=3000
DATABASE_PATH=./data.sqlite
# Your receiving bank account (BIN or short name accepted by img.vietqr.io, e.g. 970407 or TCB)
BANK_ID=TCB
BANK_ACCOUNT_NO=0000000000
BANK_ACCOUNT_NAME=YOUR COMPANY NAME
# Prefix for transfer memos. Configure the same prefix as the payment code in SePay settings.
MEMO_PREFIX=DH
# Value you set in SePay > Webhooks > Authentication "API Key"
SEPAY_WEBHOOK_API_KEY=change-me
# Protects the reconciliation endpoint
ADMIN_API_KEY=change-me-too
